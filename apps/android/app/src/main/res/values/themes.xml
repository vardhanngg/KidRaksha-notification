<resources>
    <style name="Theme.KidSuraksha" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/kd_bg</item>
        <item name="android:navigationBarColor">@color/kd_bg</item>
        <item name="android:colorAccent">@color/kd_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.KidSuraksha.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kd_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.KidSuraksha</item>
    </style>
</resources>
