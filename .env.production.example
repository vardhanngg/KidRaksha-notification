NODE_ENV=production
DOMAIN=example.com
TLS_DIR=/etc/kidraksha/tls
IMAGE_TAG=v1.0.0

POSTGRES_PASSWORD=generate-a-long-random-password
DATA_ENCRYPTION_KEY=base64-32-byte-key
DATA_ENCRYPTION_KEY_PREVIOUS=
PAIRING_CODE_SECRET=generate-a-random-secret-at-least-32-chars

REDIS_PASSWORD=generate-a-long-random-password
# Compose derives the runtime URL from REDIS_PASSWORD; keep this form documented for external deployments.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
DB_POOL_MAX=10
LOG_LEVEL=info
MAINTENANCE_INTERVAL_MS=3600000

RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_STARTER=plan_...
RAZORPAY_PLAN_FAMILY=plan_...

# Production image names can be overridden when deploying from another registry.
API_IMAGE=ghcr.io/vardhanngg/kidraksha-api
WEB_IMAGE=ghcr.io/vardhanngg/kidraksha-web
